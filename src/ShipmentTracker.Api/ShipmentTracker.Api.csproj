<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Composition root: wires Application + Infrastructure and exposes HTTP endpoints. -->
  <PropertyGroup>
    <RootNamespace>ShipmentTracker.Api</RootNamespace>
    <UserSecretsId>shipment-tracker-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShipmentTracker.Application\ShipmentTracker.Application.csproj" />
    <ProjectReference Include="..\ShipmentTracker.Infrastructure\ShipmentTracker.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Needed by `dotnet ef` when this project is the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
